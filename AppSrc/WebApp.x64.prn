38188>>>            Set peActionDisplay to adMenu
38189>>>            Procedure OnClick
38192>>>                Send RefreshRecord
38193>>>            End_Procedure
38194>>>
38194>>>        End_Object 
38195>>>    End_Object 
38196>>>
38196>>>    Procedure SetActionButtons
38199>>>        tWebNavigateData NavigateData
38199>>>        tWebNavigateData NavigateData
38199>>>        Boolean bHasRecord
38199>>>        Handle hoDD
38199>>>
38199>>>        Get Server to hoDD
38200>>>        Get GetNavigateData to NavigateData
38201>>>        Get HasRecord of hoDD to bHasRecord
38202>>>
38202>>>        // let's hide all buttons and then Show the ones we want
38202>>>        WebSet pbRender of oEditBtn to False
38203>>>        WebSet pbRender of oSaveBtn to False
38204>>>        WebSet pbRender of oCancelChangesBtn to False
38205>>>        WebSet pbRender of oDeleteBtn to False
38206>>>
38206>>>        If (NavigateData.bReadOnly) Begin
38208>>>            WebSet pbRender of oEditBtn to True
38209>>>        End
38209>>>>
38209>>>        Else Begin
38210>>>            WebSet pbRender of oSaveBtn to True
38211>>>            WebSet pbRender of oCancelChangesBtn to True
38212>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38213>>>        End
38213>>>>
38213>>>    End_Procedure
38214>>>
38214>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
38217>>>        // Close after save
38217>>>        Send NavigateClose Self
38218>>>    End_Procedure
38219>>>
38219>>>    // this will close the view after a delete
38219>>>    Procedure OnViewDeleted Handle hoDDO
38222>>>        Send NavigateClose Self
38223>>>    End_Procedure
38224>>>
38224>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38227>>>        Case Begin
38227>>>            Case (NavigateData.eNavigateType = nfFromMain)
38229>>>                // If from main, this is a propbably a main file Select to Zoom.
38229>>>                Case Break
38230>>>
38230>>>            Case (NavigateData.eNavigateType = nfFromParent)
38233>>>                // If from parent, this is a constrained drill down.
38233>>>                Case Break
38234>>>
38234>>>            Case (NavigateData.eNavigateType = nfFromChild)
38237>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38237>>>                Case Break
38238>>>
38238>>>            Case Else // must be nfUndefined
38238>>>
38238>>>        Case End
38238>>>
38238>>>        Send SetActionButtons
38239>>>
38239>>>    End_Procedure
38240>>>
38240>>>End_Object 
